---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { facts } from '../lib/facts';
import { clientImage } from '../lib/images';
import type { PageMeta } from '../lib/pages';
import { breadcrumbNode, businessNode, toJsonLd, websiteNode } from '../lib/schema';

/**
 * Page shell: everything search engines and AI systems read before the body.
 * Title, description, canonical, Open Graph and the JSON-LD graph are all
 * derived from the page entry in src/lib/pages.ts and from client/facts.yaml.
 */
interface Props {
  page: PageMeta;
  /** Open Graph image. Defaults to the business photo in facts. */
  image?: ImageMetadata;
  /** Page-specific JSON-LD nodes (restaurant, spa, FAQ). */
  jsonLd?: (Record<string, unknown> | null)[];
  /** Extra properties merged into the business node, e.g. room offers. */
  business?: Record<string, unknown>;
  /** Trail after Home. Renders visible breadcrumbs and a BreadcrumbList. */
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
}

const { page, image, jsonLd = [], business, breadcrumbs, noindex = false } = Astro.props;
const { site, business: biz } = facts;

const fullTitle = page.title === biz.name ? biz.name : `${page.title} | ${biz.name}`;
const canonical = `${site.url}${page.path}`;

const ogImage = await getImage({ src: image ?? clientImage(biz.image.src), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const bizImage = await getImage({ src: clientImage(biz.image.src), width: 1600, format: 'jpg' });
const absolute = (src: string) => new URL(src, site.url).href;

// The commit this page was built from. The release workflow waits until the live site serves it.
const build = process.env.VERCEL_GIT_COMMIT_SHA ?? 'local';

const trail = breadcrumbs ? [{ name: 'Home', path: '/' }, ...breadcrumbs] : null;
const graph = toJsonLd([
  websiteNode(),
  businessNode(absolute(bizImage.src), business),
  trail && breadcrumbNode(trail),
  ...jsonLd,
]);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={biz.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(ogImage.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1f2a24" />
    <meta name="build" content={build} />

    <Font cssVariable="--font-display-face" preload />
    <Font cssVariable="--font-text-face" preload />

    <script is:inline type="application/ld+json" set:html={graph} />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-btn focus:bg-brand focus:px-4 focus:py-2 focus:text-onaccent"
      >Skip to content</a
    >
    {site.notice && <p class="bg-dark px-4 py-2 text-center text-sm text-ondark">{site.notice}</p>}
    <SiteHeader />
    <main id="main" class="flex-1">
      {trail && <Breadcrumbs trail={trail} />}
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
