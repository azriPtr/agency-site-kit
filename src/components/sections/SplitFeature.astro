---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';

/**
 * Photo beside copy. Use for one idea per block (the restaurant, the spa,
 * the rice-field view), alternating `reverse` down the page.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  cta?: { label: string; href: string; external?: boolean };
  reverse?: boolean;
  tone?: 'base' | 'alt';
}

const { image, alt, eyebrow, title, cta, reverse = false, tone = 'base' } = Astro.props;
---

<section class:list={['section-y', tone === 'alt' ? 'bg-base-alt' : 'bg-base']}>
  <div class="wrap grid items-center gap-10 md:grid-cols-2 lg:gap-20">
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 48rem) 50vw, 100vw"
      class:list={['aspect-[4/5] w-full rounded-card object-cover', reverse && 'md:order-2']}
    />
    <div>
      {eyebrow && <p class="eyebrow text-brand">{eyebrow}</p>}
      <h2 class="display mt-3 text-3xl sm:text-4xl">{title}</h2>
      <div class="copy mt-6 text-ink-muted">
        <slot />
      </div>
      {cta && <Button {...cta} variant="secondary" class="mt-8" />}
    </div>
  </div>
</section>
