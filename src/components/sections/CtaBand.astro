---
import Button from '../ui/Button.astro';

/** Closing call to action on a dark band. One action, one sentence of support. */
interface Props {
  title: string;
  text?: string;
  cta: { label: string; href: string; external?: boolean };
}

const { title, text, cta } = Astro.props;
---

<section class="bg-dark text-ondark">
  <div class="wrap flex flex-col items-start gap-6 py-16 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="display text-3xl">{title}</h2>
      {text && <p class="mt-3 text-ondark-muted">{text}</p>}
    </div>
    <Button {...cta} variant="onDark" />
  </div>
</section>
