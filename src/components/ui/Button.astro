---
/**
 * A link styled as a button. Every CTA on these sites goes to a page, a
 * booking engine or WhatsApp, so there is no <button> variant on purpose.
 * Minimum height is 44px for touch targets.
 */
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'onDark';
  external?: boolean;
  class?: string;
}

const { href, label, variant = 'primary', external = false, class: className } = Astro.props;

const styles = {
  primary: 'bg-brand text-onaccent hover:bg-brand-hover',
  secondary: 'border border-ink/40 text-ink hover:border-ink',
  onDark: 'border border-ondark/70 text-ondark hover:bg-ondark hover:text-ink',
};
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center justify-center rounded-btn px-6 text-sm font-medium tracking-wide transition-colors duration-200',
    styles[variant],
    className,
  ]}
  {...external && { target: '_blank', rel: 'noopener' }}
>
  {label}
</a>
